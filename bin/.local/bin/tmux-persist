#!/usr/bin/env bash
# tmux-persist: keep tmux sessions/windows (and the Claude sessions in them) across reboots.
#
#   tmux-persist save      snapshot every session and window to $STATE (run from status-right)
#   tmux-persist restore   recreate missing sessions/windows from $STATE, resuming Claude in them
#
# One snapshot line per window: session TAB window name (informational) TAB directory TAB claude
# where claude is empty (not a Claude window), the Claude session id (set on the pane by
# the claude-tmux-session SessionStart hook), or "-" (Claude, id unknown -> --continue).
#
# Saving is disabled until a restore has run on this server (@persist-ready), so a
# freshly started server never overwrites the snapshot before it is restored.

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-persist"
STATE="$STATE_DIR/sessions.tsv"
SAVE_INTERVAL=10
SEP=$'\x1f'

snapshot() {
  tmux list-panes -a -F "#{session_name}${SEP}#{window_id}${SEP}#{window_name}${SEP}#{pane_active}${SEP}#{pane_current_path}${SEP}#{pane_current_command}${SEP}#{@claude_session_id}" |
  awk -F "$SEP" '
    {
      wid = $2
      if (!(wid in wsess)) { order[++n] = wid; wsess[wid] = $1; wname[wid] = $3 }
      isclaude = $6 ~ /^[0-9]+\.[0-9]+\.[0-9]+$/
      # Prefer a Claude pane; otherwise the active pane.
      if (isclaude && !(wid in wclaude)) { wclaude[wid] = ($7 != "" ? $7 : "-"); wpath[wid] = $5 }
      else if ($4 == "1" && !(wid in wclaude)) wpath[wid] = $5
    }
    END { for (i = 1; i <= n; i++) { w = order[i]; printf "%s\t%s\t%s\t%s\n", wsess[w], wname[w], wpath[w], wclaude[w] } }'
}

save() {
  [[ "$(tmux show-options -gqv @persist-ready)" == 1 ]] || return 0
  # status-right calls this every status-interval; only snapshot every SAVE_INTERVAL seconds.
  local now last
  now="$(date +%s)"
  last="$(tmux show-options -gqv @persist-last-save)"
  (( now - ${last:-0} >= SAVE_INTERVAL )) || return 0
  tmux set-option -g @persist-last-save "$now"
  mkdir -p "$STATE_DIR"
  local tmp="$STATE.tmp.$$" out
  out="$(snapshot)"
  [[ -n "$out" ]] || return 0
  printf '%s\n' "$out" > "$tmp"
  if cmp -s "$tmp" "$STATE" 2>/dev/null; then rm -f "$tmp"; else mv "$tmp" "$STATE"; fi
}

start_claude() {
  local target="$1" claude="$2" cmd
  case "$claude" in
    "") return 0 ;;
    -) cmd="claude --continue" ;;
    *) cmd="claude --resume $(printf '%q' "$claude")" ;;
  esac
  tmux send-keys -t "$target" -l "$cmd"
  tmux send-keys -t "$target" Enter
}

restore() {
  # Only once per server, even if tmux.conf is re-sourced.
  [[ "$(tmux show-options -gqv @persist-ready)" == 1 ]] && return 0
  if [[ -f "$STATE" ]]; then
    local sess name path claude wid cur="" mode=""
    # Lines are grouped by session (snapshot order).
    while IFS=$'\t' read -r sess name path claude; do
      [[ -n "$sess" ]] || continue
      [[ -d "$path" ]] || path="$HOME"
      if [[ "$sess" != "$cur" ]]; then
        cur="$sess"
        # Leave sessions that already exist alone.
        if tmux has-session -t "=$sess" 2>/dev/null; then mode=skip; continue; fi
        mode=new
        wid="$(tmux new-session -d -P -F '#{window_id}' -s "$sess" -c "$path")"
      elif [[ "$mode" == skip ]]; then
        continue
      else
        wid="$(tmux new-window -d -P -F '#{window_id}' -t "=${sess}:" -c "$path")"
      fi
      start_claude "$wid" "$claude"
    done < "$STATE"
  fi
  tmux set-option -g @persist-ready 1
}

case "${1:-}" in
  save) save ;;
  restore) restore ;;
  *) echo "usage: tmux-persist save|restore" >&2; exit 2 ;;
esac
