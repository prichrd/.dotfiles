#!/bin/bash

# Get the current pane's working directory
pane_path="$(tmux display-message -p '#{pane_current_path}')"
[[ -z "$pane_path" ]] && exit 0

# Check if we're in a git repo
git -C "$pane_path" rev-parse --is-inside-work-tree &>/dev/null || exit 0

branch=$(git -C "$pane_path" branch --show-current 2>/dev/null)
[[ -z "$branch" ]] && exit 0

# Ahead/behind
upstream=$(git -C "$pane_path" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)
ahead=""
if [[ -n "$upstream" ]]; then
  ahead_count=$(git -C "$pane_path" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)
  behind_count=$(git -C "$pane_path" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
  [[ "$ahead_count" -gt 0 ]] && ahead="↑${ahead_count}"
  [[ "$behind_count" -gt 0 ]] && ahead="${ahead}↓${behind_count}"
fi

# Dirty state
dirty=""
if [[ -n $(git -C "$pane_path" status --porcelain 2>/dev/null) ]]; then
  dirty="*"
fi

# PR status (cached to avoid rate limiting)
pr_cache="/tmp/tmux-pr-cache-$(echo "$pane_path" | md5sum | cut -d' ' -f1 2>/dev/null || md5 -q -s "$pane_path")"
pr_info=""
if [[ ! -f "$pr_cache" ]] || [[ $(find "$pr_cache" -mmin +2 2>/dev/null) ]]; then
  pr_number=$(gh pr view --json number -q '.number' -R "$(git -C "$pane_path" remote get-url origin 2>/dev/null)" "$branch" 2>/dev/null || true)
  if [[ -n "$pr_number" ]]; then
    echo "PR#${pr_number}" > "$pr_cache"
  else
    echo "" > "$pr_cache"
  fi
fi
[[ -f "$pr_cache" && -n $(cat "$pr_cache") ]] && pr_info=$(cat "$pr_cache")

# Build output
output="#[fg=green]${branch}#[fg=default]"
[[ -n "$dirty" ]] && output="${output}#[fg=yellow]${dirty}#[fg=default]"
[[ -n "$ahead" ]] && output="${output} #[fg=cyan]${ahead}#[fg=default]"
[[ -n "$pr_info" ]] && output="${output} #[fg=magenta]${pr_info}#[fg=default]"

echo "$output"
