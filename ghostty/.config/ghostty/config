# Mirrors alacritty/.alacritty.toml

# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Colors (Tokyo Night)
background = #1a1b26
foreground = #c0caf5
background-opacity = 1.0

palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
palette = 16=#ff9e64
palette = 17=#db4b4b

# Terminal
term = xterm-256color

# Alacritty defaults: no padding, steady block cursor
window-padding-x = 0
window-padding-y = 0
window-padding-color = extend
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Keybindings
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+v=unbind
keybind = cmd+shift+r=reload_config
